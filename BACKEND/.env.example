# Example .env for BACKEND (DO NOT commit real secrets)
# Copy this file to BACKEND/.env and fill values before deploying

# Flask / App
SECRET_KEY=replace_with_a_strong_random_value
FLASK_DEBUG=False

# JWT
JWT_SECRET_KEY=replace_with_a_strong_random_value

# Database (example Postgres)
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///database.db

# Optional sentry DSN
SENTRY_DSN=
# Exemple pour PostgreSQL (production) :
# postgresql://user:password@host:5432/dbname
SECRET_KEY=change_me_to_a_long_random_value
JWT_SECRET_KEY=change_me_to_a_long_random_value
DATABASE_URL=postgresql://verra_user:change_me@db:5432/verra_db
# Optional settings:
# SENTRY_DSN=
# FLASK_ENV=development
# Optional settings:
# SENTRY_DSN=
# FLASK_ENV=development