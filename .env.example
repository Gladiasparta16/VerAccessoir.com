# ⚠️ COPIER CE FICHIER EN .env ET GÉNÉRER DES SECRETS FORTS !
# À NE PAS COMMITTER DANS GIT

# Générer avec: python -c "import secrets; print(secrets.token_urlsafe(32))"

# Secrets (minimum 32 caractères aléatoires)
SECRET_KEY=CHANGE_MOI_AVEC_UN_SECRET_FORT_32_CARACTERES_MINIMUM
JWT_SECRET_KEY=CHANGE_MOI_AVEC_UN_AUTRE_SECRET_FORT_32_CARACTERES

# Database (SQLite en dev, PostgreSQL en prod)
DATABASE_URL=sqlite:///database.db
# Production: DATABASE_URL=postgresql://user:password@localhost:5432/veraccessoire

# Environment
FLASK_ENV=production
DEBUG=False

# API
API_HOST=0.0.0.0
API_PORT=5000

# Email (pour confirmation d'email)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_USE_TLS=True

# Admin (créer compte admin initial)
ADMIN_EMAIL=admin@veraccessoire.com
ADMIN_PASSWORD=CHANGE_MOI_MOT_DE_PASSE_FORT

# Frontend
FRONTEND_URL=https://veraccessoire.com

# Stripe (pour paiements)
STRIPE_PUBLIC_KEY=pk_live_xxxxx
STRIPE_SECRET_KEY=sk_live_xxxxx

# Sentry (monitoring erreurs)
SENTRY_DSN=https://xxxxx@sentry.io/xxxxx
